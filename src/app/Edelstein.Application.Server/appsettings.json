{
  "ConnectionStrings": {
    "Pgsql": "host=db;database=edelstein;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      },
      {
        "Name": "File", 
        "Args": { 
          "path": "logs/log.txt", 
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
